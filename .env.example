# Copy this file to .env and set your Upstox token for authenticated exchange quotes.
# Generate a token through your own Upstox developer account; never paste it in the UI.
UPSTOX_ACCESS_TOKEN=
# public: attempt Upstox if authorized, otherwise public Yahoo chart (possibly delayed)
# demo: deterministic sample figures only; clearly marked SAMPLE in the app
DATA_MODE=public
API_PORT=8787

# OPTIONAL: enable authenticated tick-by-tick Market Data Feed V3 WebSocket.
# Requires a current Upstox token, feed entitlement and permitted exchange-data use.
UPSTOX_STREAM=false

# OPTIONAL: enable AI Research chat via server-side Responses API.
# The assistant does not send saved holdings and never issues personalised trade advice.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# OPTIONAL read-only broker holdings import, locked to localhost and disabled by default.
# Use only with your own consented brokerage token, never expose the local API publicly.
ENABLE_BROKER_IMPORT=false
